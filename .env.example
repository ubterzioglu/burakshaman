# Supabase Postgres connection string. Use the pooler/session URL for serverless-style hosting,
# or the direct connection URL for migrations if your deployment can reach it.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"
